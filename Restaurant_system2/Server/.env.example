APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Reverb WebSocket Server Configuration
# Generate secure random strings for APP_KEY and APP_SECRET in production
REVERB_APP_ID=your-app-id
REVERB_APP_KEY=your-app-key
REVERB_APP_SECRET=your-app-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_FROM_ADDRESS="noreply@one-hotel.com"
MAIL_FROM_NAME="${APP_NAME}"

# MAIL CONFIGURATION NOTES (IMPORTANT for production deployments):
# Supports: smtp, sendmail, postmark, resend, ses, ses-v2, mailgun, log
# Recommended for production: smtp (Gmail, SendGrid, etc.), resend, postmark
# DO NOT use 'log' in production — emails will only be written to logs, not sent!
# 
# Gmail Setup:
#   1. Enable 2-factor authentication on your Google Account
#   2. Create an "App Password" at https://myaccount.google.com/apppasswords
#   3. Use the 16-character app password in MAIL_PASSWORD (remove spaces)
#   4. Set MAIL_USERNAME to your full Gmail address
#
# Render.com Deployment Note:
#   - MAIL_PORT 587 (TLS) is open on Render
#   - MAIL_PORT 465 (SSL) may be blocked — use 587 instead
#   - Ensure MAIL_ENCRYPTION=tls (not ssl)
#
# Testing Locally:
#   - Set MAIL_MAILER=log to write emails to storage/logs/laravel.log
#   - Only use 'log' for development!

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
